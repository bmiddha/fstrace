{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug fstrace (lldb)",
      "type": "lldb",
      "request": "launch",
      "program": "${workspaceFolder}/target/release/fstrace",
      "args": ["/usr/bin/cat", "${workspaceFolder}/README.md"],
      "cwd": "${workspaceFolder}",
      "env": { "RUST_LOG": "fstrace=debug" }
    }
  ]
}
